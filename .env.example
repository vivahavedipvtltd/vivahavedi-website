# Next.js Matrimonial Website - Environment Configuration

# ================================
# API Configuration
# ================================

# API Base URL - Single source of truth for all API endpoints
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# ================================
# Application Configuration
# ================================
NEXT_PUBLIC_APP_NAME=Vivahavedi Matrimony
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Feature Flags
NEXT_PUBLIC_ENABLE_SOCIAL_LOGIN=false
NEXT_PUBLIC_ENABLE_EMAIL_VERIFICATION=false
NEXT_PUBLIC_ENABLE_MOBILE_VERIFICATION=false

# Analytics (Optional)
# NEXT_PUBLIC_GA_TRACKING_ID=
# NEXT_PUBLIC_FB_PIXEL_ID=

# Image CDN (Optional)
# NEXT_PUBLIC_IMAGE_CDN_URL=

# Note: Create a .env.local file with these values for local development
